{
  "expo": {
    "name": "Notes",
    "slug": "pbhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFDF6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pb.notes",
      "infoPlist": {
        "NSCameraUsageDescription": "Attach photos to your notes.",
        "NSMicrophoneUsageDescription": "Record voice memos for your notes.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Attach pictures to your notes."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.pb.notes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFFDF6"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "allowBackup": false
    },
    "plugins": [
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "asyncStorageDatabaseSize": 20
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withDebugCleartext",
      "expo-audio",
      "expo-video",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "video/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-dot.png",
          "color": "#C9A227",
          "sounds": []
        }
      ]
    ],
    "scheme": "notes"
  }
}
